# ---- LLM (switchable provider via Vercel AI SDK) ----
# provider: anthropic | openai | openrouter | google
LLM_PROVIDER=openrouter
# model id, format depends on provider (e.g. anthropic/claude-3.5-sonnet for openrouter)
LLM_MODEL=anthropic/claude-3.5-sonnet
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ---- Postgres ----
DATABASE_URL=postgres://sera:sera@localhost:5432/sera

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Object storage (S3-compatible, e.g. Cloudflare R2) ----
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=sera-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- API ----
API_PORT=8787

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:8787
